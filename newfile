const c = navigator.credentials;
const oc = c.create.bind(c), og = c.get.bind(c);
c.create = o => { console.log('CREATE rp.id =', o?.publicKey?.rp?.id ?? '(not set: defaults to ' + location.hostname + ')'); return oc(o); };
c.get    = o => { console.log('GET rpId =', o?.publicKey?.rpId ?? '(not set: defaults to ' + location.hostname + ')', 'mediation =', o?.mediation); return og(o); };
