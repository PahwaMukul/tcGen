page.onResponse(r -> {
    String u = r.url().toLowerCase();
    if (u.contains("passkey") || u.contains("webauthn") || u.contains("fido") || u.contains("assert") || u.contains("authenticat")) {
        String body; try { body = r.text(); } catch (Exception e) { body = "<no body>"; }
        logger.info("RP response " + r.status() + " " + r.request().method() + " " + r.url() + " -> " + body);
    }
});
page.onConsoleMessage(m -> logger.info("console " + m.type() + ": " + m.text()));
